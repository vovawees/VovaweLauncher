[Unit]
Description=Dead Mile '96 API & Telegram Bot
After=network.target

[Service]
Type=simple
User=deadmile
WorkingDirectory=/opt/deadmile96/server
ExecStart=/opt/deadmile96/server/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
