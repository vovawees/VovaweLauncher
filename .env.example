APP_NAME=Dead Mile '96 API
DEBUG=false
HOST=127.0.0.1
PORT=8000
TRUST_PROXY_HEADERS=true

# SQLite и файлы клиента
DB_PATH=data/deadmile96.db
MANIFEST_PATH=data/manifest.json
CLIENT_FILES_DIR=data/client_files
FILES_BASE_URL=https://cdn.deadmile96.ru/files

# Внутренний ключ для Forge-мода и админ-скриптов (обязательно сменить!)
INTERNAL_API_KEY=change_me_to_long_random_secret_64_chars

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:replace_with_real_token
TELEGRAM_BOT_USERNAME=DeadMile96Bot
ADMIN_TG_IDS=[123456789]

# Локальный Minecraft Forge 1.20.1 сервер (для пинга онлайна)
MC_HOST=127.0.0.1
MC_PORT=25565
MC_PING_INTERVAL_SEC=10
MC_MAINTENANCE=false

# Политика безопасности и версии лаунчера
LAUNCHER_LATEST_VERSION=0.1.0
LAUNCHER_MIN_VERSION=0.1.0
LAUNCHER_SHA256_LINUX=
LAUNCHER_SHA256_WIN32=
STRICT_LAUNCHER_HASH=false

# Сроки жизни и лимиты
SESSION_TTL_DAYS=30
TG_TOKEN_TTL_SEC=600
GAME_TICKET_TTL_SEC=120
CHALLENGE_TTL_SEC=60
NICK_COOLDOWN_DAYS=7
LOG_FLUSH_INTERVAL_SEC=1.5
